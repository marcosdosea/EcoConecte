@model IEnumerable<EcoConecteWeb.Models.OrientacoesViewModel>

@{
    ViewData["Title"] = "EcoConnect - Orientações";
    var tituloFiltro = ViewData["TituloFiltro"] as string ?? "";
    var formAction = ViewData["FormAction"] as string ?? "Index";
}

<div class="container">
    <h1 class="title">
        <i class="bi bi-lightbulb me-2"></i> Orientações
    </h1>

    <div class="filter-panel mb-4">
        <form method="get" asp-action="@formAction" class="d-flex flex-wrap align-items-center gap-3">

            <div class="filter-icon">
                <i class="bi bi-funnel"></i>
            </div>

            <input type="text" class="form-control form-control-sm flex-grow-1" name="tituloFiltro" placeholder="Filtrar por título..." value="@tituloFiltro" />

            <button type="submit" class="btn btn-sm btn-eco-action">
                <i class="bi bi-search"></i> Filtrar
            </button>
            <a href="@Url.Action(formAction)" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-eraser"></i> Limpar
            </a>
        </form>
    </div>

    <p class="add-button">
        <a class="btn btn-eco-outline" asp-action="Create">
            <i class="fas fa-plus"></i> Cadastrar nova orientação
        </a>
    </p>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Titulo)</th>
                    <th>@Html.DisplayNameFor(model => model.Descricao)</th>
                    <th>@Html.DisplayNameFor(model => model.IdCooperativa)</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.Titulo)</td>
                        <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
                        <td>@Html.DisplayFor(modelItem => item.IdCooperativa)</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a class="btn btn-eco-outline btn-sm" asp-action="Edit" asp-route-id="@item.Id">
                                    <i class="fas fa-edit"></i> Editar
                                </a>
                                <a class="btn btn-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">
                                    <i class="fas fa-eye"></i> Detalhes
                                </a>
                                <a class="btn btn-danger-outline btn-sm" asp-action="Delete" asp-route-id="@item.Id">
                                    <i class="fas fa-trash"></i> Apagar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    /* Estilos do novo filtro */
    .filter-panel {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 1rem;
        border-radius: 8px;
    }

    .filter-icon {
        color: #38A169;
        font-size: 1.2rem;
    }

    .btn-eco-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #38A169;
        color: white;
        border: none;
        font-weight: 500;
        transition: background-color 0.3s;
    }

        .btn-eco-action:hover {
            background-color: #2f855a;
            color: white;
        }

    /* Estilos originais da sua página (preservados) */
    .bg-eco {
        background-color: #38A169;
    }

    .btn-eco-outline {
        background-color: transparent;
        color: #38A169;
        border: 1px solid #38A169;
        transition: all 0.3s ease;
    }

        .btn-eco-outline:hover {
            background-color: #38A169;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(56, 161, 105, 0.15);
        }

    .btn-danger-outline {
        background-color: transparent;
        color: #e3342f;
        border: 1px solid #e3342f;
        transition: all 0.3s ease;
    }

        .btn-danger-outline:hover {
            background-color: #e3342f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(227, 52, 47, 0.15);
        }

    .btn-secondary {
        background-color: transparent;
        color: #4a5568;
        border: 1px solid #4a5568;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #4a5568;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(74, 85, 104, 0.15);
        }

    .title {
        margin-top: 30px;
        font-weight: 600;
        color: #2D3748;
    }

    .add-button {
        margin-bottom: 20px;
    }
</style>