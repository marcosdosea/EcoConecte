@{
    ViewData["Title"] = "EcoConecte - Painel do Cooperado";
    var pessoaId = ViewData["PessoaId"];
}

<!-- Link para Bootstrap Icons (caso ainda não tenha no seu _Layout) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <!-- Cabeçalho da Página -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-eco-dark">Minha Conta</h1>
        <p class="lead text-muted">Bem-vindo(a)! Gerencie suas informações e agendamentos de coleta.</p>
    </div>

    <!-- Grid de Funcionalidades -->
    <div class="row g-4 justify-content-center">
        <!-- Card: Minhas Informações -->
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-person-circle fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Minhas Informações</h5>
                    <p class="card-text text-muted flex-grow-1">Visualize e edite seus dados cadastrais e de contato.</p>
                    <a asp-controller="Usuario" asp-action="Index" asp-route-id="@pessoaId" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Suporte -->
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-headset fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Suporte</h5>
                    <p class="card-text text-muted flex-grow-1">Precisa de ajuda? Entre em contato com nossa equipe.</p>
                    <a asp-controller="Suporte" asp-action="Index" class="btn btn-eco-outline mt-auto">Contato</a>
                </div>
            </div>
        </div>

        <!-- Card: Coletas Agendadas -->
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-calendar2-week-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Coletas Agendadas</h5>
                    <p class="card-text text-muted flex-grow-1">Acompanhe o histórico e o status das suas coletas.</p>
                    <a asp-controller="Usuario" asp-action="Agendadas" asp-route-id="@pessoaId" class="btn btn-eco-outline mt-auto">Consultar</a>
                </div>
            </div>
        </div>

        <!-- Card: Agendar Coleta -->
        <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-calendar-plus-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Agendar Coleta</h5>
                    <p class="card-text text-muted flex-grow-1">Solicite a retirada de materiais recicláveis de forma simples.</p>
                    <a asp-controller="Usuario" asp-action="Agendamento" asp-route-id="@pessoaId" class="btn btn-eco-outline mt-auto">Agendar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos customizados -->
<style>
    /* Suas classes de estilo existentes */
    .bg-eco {
        background-color: #38A169;
    }

    .text-eco-dark {
        color: #2F855A;
    }

    .btn-eco-outline {
        background-color: transparent;
        color: #38A169;
        border: 1px solid #38A169;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-eco-outline:hover {
            background-color: #38A169;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(56, 161, 105, 0.15);
        }

    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
    }

    /* Estilos novos para o Dashboard */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        margin-left: auto;
        margin-right: auto;
    }
</style>

