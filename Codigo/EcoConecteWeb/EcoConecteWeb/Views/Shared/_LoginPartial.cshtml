@using Microsoft.AspNetCore.Identity
@using EcoConecteWeb.Areas.Identity.Data

@inject SignInManager<UsuarioIdentity> SignInManager
@inject UserManager<UsuarioIdentity> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        var usuarioAtual = await UserManager.GetUserAsync(User);
        var email = usuarioAtual?.Email;
        var nomeUsuario = email?.Split('@')[0]; // Pegando apenas a parte antes do @
        var pessoaId = usuarioAtual?.PessoaId; // Obtendo o PessoaId

        var roles = usuarioAtual != null ? await UserManager.GetRolesAsync(usuarioAtual) : new List<string>();

        var ehAdmin = roles.Contains("ADMROOT");
        var ehCooperado = roles.Contains("COOPERADO");
        var ehCooperativa = roles.Contains("COOPERATIVA");
        var ehCliente = !ehAdmin && !ehCooperado && !ehCooperativa;

        <li class="nav-item me-3">
            <span class="nav-link">
                <i class="bi bi-person-circle me-1"></i> Olá, <span class="fw-semibold">@nomeUsuario</span>
            </span>
        </li>

        @if (ehCliente)
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Usuario" asp-action="Home" asp-route-id="@pessoaId">
                    <i class="bi bi-layout-text-window-reverse me-2"></i>Meu Painel
                </a>
            </li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="nav-link btn btn-link border-0 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                    </button>
                </form>
            </li>
        }

        @if (ehAdmin)
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="AdmRoot" asp-action="Home">
                    <i class="bi bi-layout-text-window-reverse me-2"></i>Meu Painel
                </a>
            </li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="nav-link btn btn-link border-0 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                    </button>
                </form>
            </li>
        }

        @if (ehCooperativa)
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="AdmCooperativa" asp-action="Home" asp-route-id="@pessoaId">
                    <i class="bi bi-layout-text-window-reverse me-2"></i>Meu Painel
                </a>
            </li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="nav-link btn btn-link border-0 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                    </button>
                </form>
            </li>
        }

        @if (ehCooperado)
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Cooperado" asp-action="Home" asp-route-id="@pessoaId">
                    <i class="bi bi-layout-text-window-reverse me-2"></i>Meu Painel
                </a>
            </li>
            <li class="nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="nav-link btn btn-link border-0 text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Sair
                    </button>
                </form>
            </li>
        }
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="register" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i> Registre-se
            </a>
        </li>
    }
</ul>

<!-- Estilos personalizados para o dropdown -->
<style>
    .dropdown-menu {
        padding: 0.5rem 0;
        border-radius: 0.5rem;
    }
    
    .dropdown-item {
        padding: 0.6rem 1rem;
        font-size: 0.95rem;
    }
    
    .dropdown-item:hover {
        background-color: rgba(56, 161, 105, 0.08);
    }
    
    .dropdown-item i {
        color: #38A169;
    }
    
    .dropdown-divider {
        margin: 0.5rem 0;
        opacity: 0.1;
    }
</style>
