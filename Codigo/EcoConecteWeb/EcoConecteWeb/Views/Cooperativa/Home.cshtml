@{
    ViewData["Title"] = "EcoConecte - Painel de Controle";
}

<!-- Link para Bootstrap Icons (caso ainda não tenha no seu _Layout) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <!-- Cabeçalho da Página -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-eco-dark">Painel da Cooperativa</h1>
        <p class="lead text-muted">Acesse as funcionalidades do sistema de forma rápida e fácil.</p>
    </div>

    <!-- Grid de Funcionalidades -->
    <div class="row g-4">
        <!-- Card: Dados da Cooperativa -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-building fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Dados da Cooperativa</h5>
                    <p class="card-text text-muted flex-grow-1">Visualize e gerencie os dados cadastrais da sua cooperativa.</p>
                    <a asp-controller="AdmCooperativa" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Gerenciamento -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-gear-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Gerenciamento</h5>
                    <p class="card-text text-muted flex-grow-1">Ajustes e configurações gerais do sistema e de usuários.</p>
                    <a asp-controller="Gerenciamento" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Cooperados -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-people-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Cooperados</h5>
                    <p class="card-text text-muted flex-grow-1">Adicione, edite e consulte os dados dos cooperados.</p>
                    <a asp-controller="Cooperados" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Agendamentos -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-calendar-check-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Agendamentos</h5>
                    <p class="card-text text-muted flex-grow-1">Gerencie os agendamentos de coletas e outros eventos.</p>
                    <a asp-controller="Agendamentos" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Coletas -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-box-seam-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Coletas</h5>
                    <p class="card-text text-muted flex-grow-1">Registre e acompanhe o status de todas as coletas realizadas.</p>
                    <a asp-controller="Coletas" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Notícias -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-newspaper fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Notícias</h5>
                    <p class="card-text text-muted flex-grow-1">Publique e gerencie notícias e informativos para os usuários.</p>
                    <a asp-controller="Noticias" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Orientações -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-lightbulb-fill fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Orientações</h5>
                    <p class="card-text text-muted flex-grow-1">Disponibilize guias e orientações sobre reciclagem e processos.</p>
                    <a asp-controller="Orientacoes" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>

        <!-- Card: Vendas -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3">
                        <i class="bi bi-graph-up-arrow fs-2"></i>
                    </div>
                    <h5 class="card-title mb-2">Vendas</h5>
                    <p class="card-text text-muted flex-grow-1">Controle as vendas de materiais e gere relatórios financeiros.</p>
                    <a asp-controller="Vendas" asp-action="Index" class="btn btn-eco-outline mt-auto">Acessar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos customizados -->
<style>
    /* Cor de fundo principal */
    .bg-eco {
        background-color: #38A169;
    }

    /* Cor de texto escura */
    .text-eco-dark {
        color: #2F855A;
    }

    /* Estilo para o botão eco-outline */
    .btn-eco-outline {
        background-color: transparent;
        color: #38A169;
        border: 1px solid #38A169;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-eco-outline:hover {
            background-color: #38A169;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(56, 161, 105, 0.15);
        }

    /* Estilos herdados do seu exemplo (para consistência) */
    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
    }

    .form-control {
        border-radius: 0.375rem;
    }

    /* Estilos novos para o Dashboard */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        margin-left: auto;
        margin-right: auto;
    }
</style>
