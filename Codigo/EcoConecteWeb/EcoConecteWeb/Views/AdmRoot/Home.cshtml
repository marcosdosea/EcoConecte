@{
    ViewData["Title"] = "EcoConecte - Painel Administrativo";
}

<!-- Link para Bootstrap Icons (caso ainda não tenha no seu _Layout) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <!-- Cabeçalho da Página -->
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-eco-dark">Painel Administrativo</h1>
        <p class="lead text-muted">Gerenciamento completo do sistema EcoConecte.</p>
    </div>

    <!-- Grid de Funcionalidades -->
    <div class="row g-4 justify-content-center">

        <!-- Seção: Gerenciamento de Conta -->
        <div class="col-12 mt-5 mb-3">
            <h4 class="text-eco-dark border-bottom pb-2">Minha Conta</h4>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-key-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Alterar Senha</h5>
                    <p class="card-text text-muted flex-grow-1">Modifique sua senha de acesso.</p>
                    <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-eco-outline mt-auto">Alterar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-envelope-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Alterar E-mail</h5>
                    <p class="card-text text-muted flex-grow-1">Modifique seu e-mail de acesso.</p>
                    <a href="/Identity/Account/Manage/Email" class="btn btn-eco-outline mt-auto">Alterar</a>
                </div>
            </div>
        </div>

        <!-- Seção: Administração de Contas -->
        <div class="col-12 mt-5 mb-3">
            <h4 class="text-eco-dark border-bottom pb-2">Administração de Contas</h4>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-people-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Geenciar Usuários/Logins</h5>
                    <p class="card-text text-muted flex-grow-1">Gerencie todos os usuários do Sistema.</p>
                    <a asp-controller="AdmIdentity" asp-action="Users" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-shield-lock-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Grupo/Funções</h5>
                    <p class="card-text text-muted flex-grow-1">Gerencie os papéis e permissões.</p>
                    <a asp-controller="AdmIdentity" asp-action="Roles" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>

        <!-- Seção: Administração do Sistema -->
        <div class="col-12 mt-5 mb-3">
            <h4 class="text-eco-dark border-bottom pb-2">Administração do Sistema</h4>
        </div>

        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-person-lines-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Pessoas</h5>
                    <p class="card-text text-muted flex-grow-1">Gerencie o cadastro de pessoas.</p>
                    <a asp-controller="Pessoa" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-building-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Cooperativas</h5>
                    <p class="card-text text-muted flex-grow-1">Gerencie o cadastro de cooperativas.</p>
                    <a asp-controller="Cooperativa" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-calendar-check-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Agendamentos</h5>
                    <p class="card-text text-muted flex-grow-1">Visualize e gerencie agendamentos.</p>
                    <a asp-controller="Agendamento" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-truck fs-2"></i></div>
                    <h5 class="card-title mb-2">Coletas</h5>
                    <p class="card-text text-muted flex-grow-1">Acompanhe e administre as coletas.</p>
                    <a asp-controller="Coleta" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-newspaper fs-2"></i></div>
                    <h5 class="card-title mb-2">Notícias</h5>
                    <p class="card-text text-muted flex-grow-1">Publique e gerencie notícias.</p>
                    <a asp-controller="Noticia" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-info-circle-fill fs-2"></i></div>
                    <h5 class="card-title mb-2">Orientações</h5>
                    <p class="card-text text-muted flex-grow-1">Publique e gerencie orientações.</p>
                    <a asp-controller="Orientacoes" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm feature-card">
                <div class="card-body text-center d-flex flex-column">
                    <div class="feature-icon bg-eco text-white mb-3"><i class="bi bi-graph-up-arrow fs-2"></i></div>
                    <h5 class="card-title mb-2">Vendas</h5>
                    <p class="card-text text-muted flex-grow-1">Acompanhe os registros de vendas.</p>
                    <a asp-controller="Venda" asp-action="" class="btn btn-eco-outline mt-auto">Gerenciar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estilos customizados -->
<style>
    /* Suas classes de estilo existentes */
    .bg-eco {
        background-color: #38A169;
    }

    .text-eco-dark {
        color: #2F855A;
    }

    .btn-eco-outline {
        background-color: transparent;
        color: #38A169;
        border: 1px solid #38A169;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-eco-outline:hover {
            background-color: #38A169;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(56, 161, 105, 0.15);
        }

    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
    }

    /* Estilos novos para o Dashboard */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

    .feature-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        margin-left: auto;
        margin-right: auto;
    }
</style>
