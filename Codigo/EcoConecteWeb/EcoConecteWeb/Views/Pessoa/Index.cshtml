@model IEnumerable<EcoConecteWeb.Models.PessoaViewModel>

@{
    ViewData["Title"] = "EcoConecte - Pessoas";

    var nomeFiltro = ViewData["NomeFiltro"] as string ?? "";
    var cpfFiltro = ViewData["CpfFiltro"] as string ?? "";
    var cidadeFiltro = ViewData["CidadeFiltro"] as string ?? "";
    var statusFiltro = ViewData["StatusFiltro"] as string ?? "";
    var formAction = ViewData["FormAction"] as string ?? "Index";
}

<h1 class="title">
    <i class="bi bi-person me-2"></i> Pessoa
</h1>

<div class="filter-panel mb-4">
    <form method="get" asp-action="@formAction" class="d-flex flex-wrap align-items-center gap-3">

        <div class="filter-icon">
            <i class="bi bi-funnel"></i>
        </div>

        <input type="text" class="form-control form-control-sm" name="nomeFiltro" placeholder="Nome" value="@nomeFiltro" />
        <input type="text" class="form-control form-control-sm" name="cpfFiltro" placeholder="CPF" value="@cpfFiltro" />
        <input type="text" class="form-control form-control-sm" name="cidadeFiltro" placeholder="Cidade" value="@cidadeFiltro" />
        <input type="text" class="form-control form-control-sm" name="statusFiltro" placeholder="Status" value="@statusFiltro" />

        <button type="submit" class="btn btn-sm btn-eco-action">
            <i class="bi bi-search"></i> Filtrar
        </button>
        <a href="@Url.Action(formAction)" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-eraser"></i> Limpar
        </a>
    </form>
</div>


<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Cpf)</th>
            <th>@Html.DisplayNameFor(model => model.Nome)</th>
            <th>@Html.DisplayNameFor(model => model.Telefone)</th>
            <th>@Html.DisplayNameFor(model => model.Logradouro)</th>
            <th>@Html.DisplayNameFor(model => model.Numero)</th>
            <th>@Html.DisplayNameFor(model => model.Bairro)</th>
            <th>@Html.DisplayNameFor(model => model.Cidade)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>@Html.DisplayNameFor(model => model.IdCooperativa)</th>
            <th>@Html.DisplayNameFor(model => model.Status)</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Id)</td>
                <td>@Html.DisplayFor(modelItem => item.Cpf)</td>
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                <td>@Html.DisplayFor(modelItem => item.Logradouro)</td>
                <td>@Html.DisplayFor(modelItem => item.Numero)</td>
                <td>@Html.DisplayFor(modelItem => item.Bairro)</td>
                <td>@Html.DisplayFor(modelItem => item.Cidade)</td>
                <td>@Html.DisplayFor(modelItem => item.Estado)</td>
                <td>@Html.DisplayFor(modelItem => item.IdCooperativa)</td>
                <td>@Html.DisplayFor(modelItem => item.Status)</td>
                <td>
                    <div class="button-group">
                        <button class="icon-button">
                            <a href="@Url.Action("Edit", new { id = item.Id })">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                        </button>
                        <button class="icon-button">
                            <a href="@Url.Action("Details", new { id = item.Id })">
                                <i class="fas fa-info-circle"></i> Detalhes
                            </a>
                        </button>
                        <button class="icon-button">
                            <a href="@Url.Action("Delete", new { id = item.Id })">
                                <i class="fas fa-trash"></i> Apagar
                            </a>
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .title {
        font-size: 2rem;
        font-weight: 700;
        color: #2D3748;
    }

    /* Estilos do filtro novo */
    .filter-panel {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 1rem;
        border-radius: 8px;
    }

        .filter-panel .form-control-sm {
            min-width: 150px;
            flex: 1;
        }

    .filter-icon {
        color: #38A169;
        font-size: 1.2rem;
    }

    .btn-eco-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #38A169;
        color: white;
        border: none;
        font-weight: 500;
        transition: background-color 0.3s;
    }

        .btn-eco-action:hover {
            background-color: #2f855a;
            color: white;
        }

    .btn-outline-secondary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* Estilos originais da sua tabela e botões (preservados) */
    .icon-button {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #38A169;
        color: white;
        border: none;
        padding: 6px 12px;
        font-size: 0.875rem;
        font-weight: 500;
        border-radius: 5px;
        text-decoration: none;
        transition: background-color 0.3s;
    }

        .icon-button:hover {
            background-color: #2f855a;
            color: white;
            text-decoration: none;
        }

        /* Garante que o link dentro do botão ocupe todo o espaço e tenha a cor correta */
        .icon-button a {
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .table thead th {
        vertical-align: middle;
    }
</style>